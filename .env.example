DATABASE_PATH=./data/assets.db
MEDIA_ROOT=./media
MAX_IMAGE_BYTES=20971520
MAX_VIDEO_BYTES=209715200

# openai_chat_completions or openai_responses
MODEL_PROTOCOL=openai_chat_completions
MODEL_BASE_URL=https://example.com/v1
MODEL_API_KEY=
MODEL_NAME=
MODEL_TIMEOUT_MS=120000
MODEL_VIDEO_TIMEOUT_MS=300000
MODEL_RETRY_COUNT=1

# auto: videos below 7 MiB use Base64; larger videos use APP_PUBLIC_URL.
# chat_video_url remains available for URL-only backward compatibility.
MODEL_VIDEO_MODE=auto
MODEL_VIDEO_FPS=1
APP_PUBLIC_URL=
MEDIA_SIGNING_SECRET=replace-with-a-long-random-secret
