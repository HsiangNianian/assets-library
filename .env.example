DATABASE_PATH=./data/assets.db
MEDIA_ROOT=./media
MAX_IMAGE_BYTES=20971520
MAX_VIDEO_BYTES=209715200

# openai_chat_completions or openai_responses
MODEL_PROTOCOL=openai_chat_completions
# NewAPI/OpenAI-compatible Base URL should include /v1.
MODEL_BASE_URL=http://183.147.142.111:30000/v1
# Leave empty only when the gateway has authentication disabled.
MODEL_API_KEY=
MODEL_NAME=qwen3.6-plus
MODEL_TIMEOUT_MS=120000
MODEL_VIDEO_TIMEOUT_MS=300000
MODEL_RETRY_COUNT=1
# Qwen3.7 defaults to thinking mode; disable it for fast structured extraction.
MODEL_ENABLE_THINKING=false

# frames: analyze browser-generated JPEG keyframes; disabled: reject video analysis.
MODEL_VIDEO_MODE=frames
